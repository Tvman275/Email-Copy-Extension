{
  "manifest_version": 3,
  "name": "Email Copy Extension",
  "version": "1.0.1",
  "description": "Save email addresses and copy the selected address in one click.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/exotic-16.png",
    "32": "icons/exotic-32.png",
    "48": "icons/exotic-48.png",
    "128": "icons/exotic-128.png"
  },
  "action": {
    "default_title": "Email Copy Extension",
    "default_icon": {
      "16": "icons/exotic-16.png",
      "32": "icons/exotic-32.png"
    },
    "default_popup": "popup.html"
  }
}
